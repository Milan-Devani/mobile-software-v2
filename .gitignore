# ==========================================
# Dependencies
# ==========================================
node_modules/
.pnp
.pnp.js

# ==========================================
# Build & Distribution Artifacts
# ==========================================
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ==========================================
# Environment Files (Keep secrets local & out of Git)
# ==========================================
.env
.env.*
*.env
*.env.*
server/.env.local_backup

# ==========================================
# Runtime Uploads & Generated Media
# (Preserves directory structure via .gitkeep while ignoring uploaded files)
# ==========================================
server/uploads/*
!server/uploads/.gitkeep

# ==========================================
# WhatsApp Baileys Authentication & Session Keys
# (Preserves directory structure via .gitkeep while ignoring session tokens)
# ==========================================
server/data/baileys_auth/*
!server/data/baileys_auth/.gitkeep

# ==========================================
# Logs & Diagnostics
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Cache & Temporary Files
# ==========================================
.npm/
.eslintcache
.stylelintcache
.parcel-cache
.vite/
*.tmp
*.temp

# ==========================================
# Operating System & IDE Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
