{
  "name": "mobile-repair-management-system",
  "version": "1.0.0",
  "description": "Production-ready Mobile Repair Management System",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "node tests/e2e.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
