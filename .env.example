# ==============================================================================
# MOBILE REPAIR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_fixit_repair_system_2026_xyz987
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL & Storage Configuration
# If left empty, the server automatically operates in local persistent mode
# Once you provide your Supabase credentials, it seamlessly connects to Supabase!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=repair-assets

# Email Service: Brevo (formerly Sendinblue)
# https://app.brevo.com/ -> SMTP & API
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Mobotech mobile care <notifications@mobotech.com>

# WhatsApp Service: OpenWA
# https://github.com/rmyndharis/OpenWA
OPENWA_API_URL=http://localhost:8000
OPENWA_API_KEY=
OPENWA_SESSION_ID=default

# SMS Service: MSG91
# https://msg91.com/
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=TCHFIX
MSG91_TEST_MODE=true

# ==============================================================================
# DATABASE BACKUP & GOOGLE DRIVE INTEGRATION (AES-256-GCM Encrypted)
# ==============================================================================
# Direct/Pooler PostgreSQL URL for full logical pg_dump / psql restore
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google Drive API (OAuth 2.0 - Run `node src/scripts/setupGoogleDriveAuth.js` to configure)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Dedicated backup folder ID (Optional: leave blank to auto-create "Supabase Database Backups")
GOOGLE_DRIVE_FOLDER_ID=

# 32-byte Encryption Key for AES-256-GCM (64 hex characters or passphrase)
# NEVER commit or share this key! Store a separate recovery copy in a password manager.
BACKUP_ENCRYPTION_KEY=

# Retention policy (days before pruning old backups; default: 30)
BACKUP_RETENTION_DAYS=30

# Optional custom temporary directory for backup staging (defaults to OS temp)
BACKUP_TEMP_DIR=

# Backup execution timeout in milliseconds (default: 300000 = 5 minutes)
BACKUP_TIMEOUT_MS=300000

# Backup schedule documentation (cron format: default 2:00 AM UTC daily)
BACKUP_SCHEDULE=0 2 * * *

