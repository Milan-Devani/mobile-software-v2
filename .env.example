# ==============================================================================
# MOBILE REPAIR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_fixit_repair_system_2026_xyz987
JWT_EXPIRES_IN=7d

# Supabase PostgreSQL & Storage Configuration
# If left empty, the server automatically operates in local persistent mode
# Once you provide your Supabase credentials, it seamlessly connects to Supabase!
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=repair-assets

# Email Service: Brevo (formerly Sendinblue)
# https://app.brevo.com/ -> SMTP & API
BREVO_API_KEY=
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Mobotech mobile care <notifications@mobotech.com>

# WhatsApp Service: OpenWA
# https://github.com/rmyndharis/OpenWA
OPENWA_API_URL=http://localhost:8000
OPENWA_API_KEY=
OPENWA_SESSION_ID=default

# SMS Service: MSG91
# https://msg91.com/
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=TCHFIX
MSG91_TEST_MODE=true
